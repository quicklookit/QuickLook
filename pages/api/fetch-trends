// pages/api/fetch-trends.js
import googleTrends from 'google-trends-api';
import pLimit from 'p-limit';

// Fetch keyword in smaller chunks (e.g. 30 days) and stitch results
async function fetchKeywordOverSegments(kw, startTime, endTime, segmentDays = 30) {
  const segments = [];
  for (let t = new Date(startTime); t < endTime; ) {
    const segStart = new Date(t);
    const segEnd = new Date(
      Math.min(segStart.getTime() + segmentDays * 24 * 60 * 60 * 1000, endTime.getTime())
    );
    segments.push({ segStart, segEnd });
    // move forward one day so segments overlap slightly
    t = new Date(segEnd.getTime() + 24 * 60 * 60 * 1000);
  }

  const parts = await Promise.all(
    segments.map(async ({ segStart, segEnd }) => {
      const json = await googleTrends.interestOverTime({
        keyword: kw,
        startTime: segStart,
        endTime: segEnd,
        geo: '',
        hl: 'en-US',
        timezone: 0,
        granularTimeResolution: true, // finer-grained results
      });
      const parsed = JSON.parse(json);
      return parsed?.default?.timelineData ?? [];
    })
  );

  // Flatten & de-duplicate by timestamp
  const byTs = new Map();
  for (const arr of parts) {
    for (const e of arr) {
      byTs.set(e.time, e);
    }
  }
  return [...byTs.values()].sort((a, b) => Number(a.time) - Number(b.time));
}

export default async function handler(req, res) {
  const days = Number.isFinite(parseInt(req.query.days, 10))
    ? parseInt(req.query.days, 10)
    : 180;

  const endTime = new Date();
  const startTime = new Date(Date.now() - days * 24 * 60 * 60 * 1000);

  const keywords = [
    'cosmetics',
    'lipstick',
    'male underwear',
    'PMI index',
    'interest rates',
    'mortgage lending',
    'credit card debt',
    'job openings',
    'house prices',
    'European Central Bank',
    'Federal Reserve',
    'Bank for International Settlements',
    'XRP',
    'gold',
    'bitcoin',
    'nasdaq',
  ];

  const limit = pLimit(3); // lower concurrency just in case

  try {
    const results = await Promise.all(
      keywords.map((kw) =>
        limit(async () => {
          try {
            const timelineData = await fetchKeywordOverSegments(kw, startTime, endTime, 30);
            console.log(`ℹ️ ${kw}: ${timelineData.length} points`);
            return { kw, timelineData };
          } catch (err) {
            console.error(`🔴 Trend fetch failed for [${kw}]:`, err.message);
            return { kw, timelineData: [] };
          }
        })
      )
    );

    // Merge all keywords by day
    const byDay = new Map();
    for (const item of results) {
      for (const entry of item.timelineData) {
        const d = new Date(Number(entry.time) * 1000);
        const key = d.toISOString().slice(0, 10); // YYYY-MM-DD
        const existing = byDay.get(key) || { date: new Date(key).toISOString() };
        const v = Array.isArray(entry.value) ? entry.value[0] : entry.value;
        existing[item.kw] = Number.isFinite(v) ? v : 0;
        byDay.set(key, existing);
      }
    }

    const normalized = [...byDay.values()].sort(
      (a, b) => new Date(a.date) - new Date(b.date)
    );

    res.setHeader('Cache-Control', 'no-store');
    res.status(200).json(normalized);
  } catch (err) {
    console.error('🔴 Error in /api/fetch-trends:', err);
    res.setHeader('Cache-Control', 'no-store');
    res.status(500).json({ error: 'Failed to fetch trends', detail: String(err) });
  }
}
